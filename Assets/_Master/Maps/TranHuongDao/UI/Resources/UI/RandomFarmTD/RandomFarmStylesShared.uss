:root {
    --color-game-gold: #ffd700;
    --color-game-gold-dim: rgba(212, 175, 55, 0.4);
    --color-game-wood: #4d2b17;
    --color-game-border: rgba(139, 69, 19, 0.5);
    --color-bg-panel: rgba(26, 26, 26, 0.85);
    --color-bg-item: rgba(0, 0, 0, 0.4);
    
    --color-carrot: #ff8c00;
    --color-apple: #ff4d4d;
    --color-grape: #9932cc;
    --color-hammer: #a0522d;
    --color-heart: #ff4d4d;
}

.game-panel {
    background-color: var(--color-bg-panel);
    border-width: 2px;
    border-color: var(--color-game-border);
    border-radius: 12px;
    padding: 12px;
}

.gold-text {
    color: var(--color-game-gold);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.game-button {
    background-color: var(--color-game-wood);
    border-width: 1px;
    border-color: var(--color-game-gold-dim);
    color: var(--color-game-gold);
    border-radius: 4px;
    transition-duration: 0.1s;
}

.game-button:hover {
    background-color: #5d3b27;
    scale: 1.05;
    border-color: var(--color-game-gold);
}

.game-button:active {
    scale: 0.95;
    background-color: #3d1b07;
}

.stat-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 20px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    margin-right: 8px;
}

.popup-header {
    height: 60px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-color: var(--color-game-border);
    margin-bottom: 12px;
    background-color: rgba(139, 69, 19, 0.1);
}

.popup-title {
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.icon-box {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}
