.popup-overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.shop-item-icon {
    width: 90px;
    height: 90px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    margin: 5px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.1s;
}

.shop-item-icon:hover {
    border-color: var(--color-game-gold);
    scale: 1.05;
    background-color: rgba(255, 215, 0, 0.05);
}

.market-item-row {
    flex-direction: row;
    padding: 12px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    align-items: center;
}

.trend-up {
    color: #4ade80;
}

.trend-down {
    color: #f87171;
}

.farm-slot {
    width: 110px;
    height: 110px;
    background-color: rgba(0,0,0,0.4);
    border-width: 1px;
    border-color: rgba(255,255,255,0.05);
    border-radius: 12px;
    margin: 8px;
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.farm-slot:hover {
    border-color: var(--color-game-gold);
}

.guide-tab-btn {
    flex: 1;
    height: 32px;
    background-color: transparent;
    border-width: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 6px;
}

.guide-tab-btn.active {
    background-color: var(--color-game-gold);
    color: #000;
}

.dot-gold {
    width: 8px;
    height: 8px;
    background-color: var(--color-game-gold);
    border-radius: 4px;
    margin-right: 8px;
}

.border-gold {
    border-color: var(--color-game-gold);
    border-width: 1px;
}

.border-wood {
    border-color: var(--color-game-border);
    border-width: 1px;
}

.icon-tier-5 {
    background-color: #d4af37;
    border-color: var(--color-game-gold);
}
