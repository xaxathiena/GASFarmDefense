<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../../../../UI/Common.uss" />
    <Style src="RandomFarmPopups.uss" />
    <ui:VisualElement class="popup-overlay">
        <ui:VisualElement class="popup-window">
            
            <ui:VisualElement class="popup-header">
                <ui:Label text="• PREMIUM SHOP" class="text-gold" style="font-size: 24px; -unity-font-style: bold;" />
                <ui:Button name="btn-close" text="✕" class="popup-close-btn" />
            </ui:VisualElement>

            <ui:ScrollView class="flex-1">
                <!-- Currency Info -->
                <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-bottom: 15px; padding-right: 10px;">
                    <ui:Label text="Gold: 1,250" class="text-gold" style="margin-right: 20px;" />
                    <ui:Label text="Gems: 250" class="text-red" />
                </ui:VisualElement>

                <!-- Tower Packs -->
                <ui:VisualElement class="shop-grid">
                    <ui:VisualElement class="shop-item">
                        <ui:VisualElement style="align-items: center; justify-content: center; height: 40px;">
                            <ui:VisualElement name="icon-lvl1" style="width: 32px; height: 32px; background-color: #555; border-width: 1px; border-color: #888; border-radius: 2px;" />
                        </ui:VisualElement>
                        <ui:Label text="LVL 1 RANDOM PACK" style="white-space: normal; -unity-text-align: middle-center; font-size: 10px; height: 24px; color: #fff;" />
                        <ui:Button text="💰 10" class="shop-item-btn" />
                    </ui:VisualElement>

                    <ui:VisualElement class="shop-item">
                        <ui:VisualElement style="align-items: center; justify-content: center; height: 40px;">
                            <ui:VisualElement name="icon-lvl5" class="bg-primary" style="width: 32px; height: 32px; border-width: 1px; border-color: #fff; border-radius: 2px;" />
                        </ui:VisualElement>
                        <ui:Label text="LVL 5 PREMIUM PACK" class="text-gold" style="white-space: normal; -unity-text-align: middle-center; font-size: 10px; height: 24px;" />
                        <ui:Button text="💰 100" class="shop-item-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Weapons Section -->
                <ui:VisualElement class="flex-row space-between" style="margin-top: 10px; border-bottom-width: 1px; border-color: #333; padding-bottom: 5px;">
                    <ui:Label text="FORGE" class="text-gold" style="-unity-font-style: bold; font-size: 14px;" />
                    <ui:Label text="↻ NEXT IN 4H" class="text-gray" style="font-size: 9px;" />
                </ui:VisualElement>
                <ui:VisualElement class="flex-row" style="margin-top: 10px; flex-wrap: wrap;">
                    <ui:VisualElement class="bg-neutral-light" style="width: 80px; height: 80px; border-width: 1px; border-color: #444; margin-right: 12px; margin-bottom: 12px; border-radius: 4px;" />
                    <ui:VisualElement class="bg-neutral-light" style="width: 80px; height: 80px; border-width: 1px; border-color: #444; margin-right: 12px; margin-bottom: 12px; border-radius: 4px;" />
                    <ui:VisualElement class="bg-neutral-light" style="width: 80px; height: 80px; border-width: 1px; border-color: #444; margin-right: 12px; margin-bottom: 12px; border-radius: 4px;" />
                    <ui:VisualElement class="bg-neutral-light" style="width: 80px; height: 80px; border-width: 1px; border-color: #444; margin-right: 12px; margin-bottom: 12px; border-radius: 4px;" />
                </ui:VisualElement>

            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
