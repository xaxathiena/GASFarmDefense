<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../../../../UI/Common.uss" />
    <Style src="RandomFarmPopups.uss" />
    <ui:VisualElement class="popup-overlay" picking-mode="Position">
        <ui:VisualElement class="popup-window" picking-mode="Position">
            
            <ui:VisualElement class="popup-header">
                <ui:Label text="• INTEL ARCHIVE" class="text-gold" style="font-size: 24px; -unity-font-style: bold;" />
                <ui:Button name="btn-close" text="✕" class="popup-close-btn" />
            </ui:VisualElement>

            <!-- Tabs -->
            <ui:VisualElement class="flex-row space-between" style="margin-bottom: 15px;">
                <ui:Button name="tab-howtoplay" text="BASICS" class="secondary-btn flex-1" style="height: 32px; margin-right: 4px; font-size: 10px;" />
                <ui:Button name="tab-shopinfo" text="DATABASE" class="primary-btn flex-1" style="height: 32px; margin-right: 4px; font-size: 10px;" />
                <ui:Button name="tab-towertiers" text="ARMY" class="secondary-btn flex-1" style="height: 32px; font-size: 10px;" />
            </ui:VisualElement>

            <ui:ScrollView class="flex-1" style="background-color: #0d0d0d; padding: 12px; border-width: 1px; border-color: #333; border-radius: 4px;">
                <ui:VisualElement name="tab-content-shopinfo">
                    <ui:VisualElement class="flex-row" style="margin-bottom: 20px;">
                        <ui:VisualElement class="bg-neutral-light border-primary" style="width: 100px; height: 100px; border-width: 1px; margin-right: 15px; border-radius: 4px;" />
                        <ui:VisualElement class="flex-1">
                            <ui:Label text="ENTRY #W3-AXE" class="text-gray" style="font-size: 9px;" />
                            <ui:Label text="HEAVY AXE" class="text-gold" style="font-size: 20px; -unity-font-style: bold;" />
                            <ui:Label text="MELEE CLASS" class="text-gray" style="font-size: 10px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="border-primary" style="background-color: rgba(212,175,55,0.05); border-width: 1px; padding: 12px; margin-bottom: 20px; border-radius: 2px;">
                         <ui:Label text="+30% SIEGE DAMAGE" class="text-gold" style="-unity-font-style: bold; -unity-text-align: middle-center; font-size: 12px;" />
                    </ui:VisualElement>

                    <ui:Label text="FIELD NOTES" class="text-gray" style="font-size: 9px; margin-bottom: 4px;" />
                    <ui:Label text="&quot;Slow but hits like a truck. Effective against fortified positions.&quot;" class="text-white" style="white-space: normal; font-size: 12px; -unity-font-style: italic; opacity: 0.8;" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement class="flex-row space-between bg-neutral-light" style="margin-top: 15px; padding: 8px; border-width: 1px; border-color: #444; border-radius: 4px;">
                <ui:VisualElement>
                    <ui:Label text="SYSTEM STATUS" class="text-gray" style="font-size: 9px;" />
                    <ui:Label text="ALL SYSTEMS NOMINAL" class="text-green" style="-unity-font-style: bold; font-size: 10px;" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: flex-end;">
                     <ui:Label text="VERSION 1.0.4" class="text-gray" style="font-size: 9px;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
