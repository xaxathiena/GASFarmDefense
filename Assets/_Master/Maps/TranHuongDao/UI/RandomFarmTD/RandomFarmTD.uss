.hud-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    /* background-color removed to see the 3D map */
    min-height: 100%;
}

/* Resource Bar - High Visibility */
.res-bar {
    height: 48px;
    background-color: rgba(15, 15, 15, 0.95);
    border-bottom-width: 2px;
    border-color: var(--color-primary);
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
}

.res-item {
    flex-direction: row;
    align-items: center;
    margin-right: 15px;
}

.res-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    background-color: #333;
}

.res-text {
    font-size: 14px;
    color: var(--color-text);
    -unity-font-style: bold;
}

/* Side Menu - Floating Icons */
.side-menu {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    flex-direction: column;
    align-items: flex-end;
}

.menu-btn {
    width: 64px;
    height: 64px;
    background-color: rgba(26, 26, 26, 0.9);
    border-width: 1px;
    border-color: var(--color-primary);
    margin-bottom: 12px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.1s;
    padding: 6px;
}

.menu-btn:hover {
    background-color: var(--color-primary);
    scale: 1.1;
}

.menu-btn-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 2px;
}

.menu-btn-text {
    font-size: 11px;
    color: var(--color-primary);
    -unity-text-align: middle-center;
}

/* Card Deck - Premium Stacked Look */
.card-container {
    position: absolute;
    bottom: 25px;
    left: 20px;
    height: 140px;
    flex-direction: row;
    align-items: flex-end;
}

.card-item {
    width: 120px;
    height: 160px;
    background-color: var(--color-neutral-light);
    border-width: 1px;
    border-color: #444;
    border-radius: 4px;
    margin-right: -45px; /* Overlap effect */
    transition-duration: 0.2s;
    transition-property: translate, rotate, border-color, scale;
    padding: 8px;
    overflow: hidden;
}

.card-item:hover {
    translate: 0 -20px;
    border-color: var(--color-primary);
    border-width: 2px;
    z-index: 100;
    scale: 1.15;
}

.card-lvl {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 12px;
    color: #ccc;
    z-index: 2;
}

.card-image-box {
    flex: 1;
    background-color: #111;
    border-radius: 2px;
    margin-bottom: 4px;
}

.card-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* Special Highlighting - Gold Card */
.card-item.gold {
    border-color: #d4af37;
    background-color: rgba(212, 175, 55, 0.1);
}

.card-item.gold .card-name {
    color: #d4af37;
}

/* Drag states */
.card-item.dragging {
    border-color: #ffd700; /* Yellow border when dragging */
    border-width: 2px;
    scale: 1.1;
    opacity: 0.8;
}

.card-item.valid {
    border-color: #00ff00; /* Green border when over valid spot */
    border-width: 3px;
    background-color: rgba(0, 255, 0, 0.1);
}

.card-item.invalid {
    border-color: #ff0000; /* Red border when over invalid spot */
    border-width: 2px;
    background-color: rgba(255, 0, 0, 0.1);
}
