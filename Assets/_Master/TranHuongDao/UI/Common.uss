:root {
    --color-primary: #D4AF37;
    --color-secondary: #8B0000;
    --color-tertiary: #006400;
    --color-neutral: #1A1A1A;
    --color-neutral-light: #2A2A2A;
    --color-text: #E0E0E0;
    --color-header: #D4AF37;
}

.ui-hidden {
    opacity: 0;
    transition-duration: 0.3s;
    transition-property: opacity;
}

.view-root {
    width: 100%;
    height: 100%;
    background-color: var(--color-neutral);
    flex-direction: column;
    color: var(--color-text);
    font-family: sans-serif; /* We'll use this as fallback */
    transition-duration: 0.3s;
    transition-property: opacity;
}

/* Typography */
.text-gold { color: var(--color-primary); }
.text-gray { color: #888888; }
.text-white { color: #ffffff; }
.text-green { color: var(--color-tertiary); }
.text-red { color: var(--color-secondary); }

.header-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--color-header);
    /* For headlines we would ideally use a Serif font, 
       but we keep it standard for now unless font assets are provided */
}

/* Layout building blocks */
.flex-row { flex-direction: row; }
.flex-col { flex-direction: column; }
.flex-1 { flex-grow: 1; }
.space-between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }

/* Components */
.panel-dark {
    background-color: var(--color-neutral);
    border-width: 1px;
    border-color: #333;
    border-radius: 4px;
}

.ornate-border {
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 2px;
}

.primary-btn {
    background-color: var(--color-primary);
    color: #111111;
    -unity-font-style: bold;
    border-radius: 2px;
    padding: 10px 15px;
    font-size: 16px;
    border-width: 0;
    transition-duration: 0.1s;
}
.primary-btn:hover {
    background-color: #fce48b;
    scale: 1.05;
}

.secondary-btn {
    background-color: var(--color-neutral-light);
    color: #aaaaaa;
    border-radius: 2px;
    padding: 10px 15px;
    font-size: 14px;
    border-width: 1px;
    border-color: #444;
}
.secondary-btn:hover { 
    background-color: #3a3a3a;
    color: #ffffff;
}

.outlined-btn {
    background-color: transparent;
    color: var(--color-primary);
    border-width: 1px;
    border-color: var(--color-primary);
    border-radius: 2px;
    padding: 8px 12px;
}
.outlined-btn:hover {
    background-color: rgba(212, 175, 55, 0.1);
}

/* Animations */
.slide-right-hidden {
    translate: 500px 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-in;
}

.slide-top-hidden {
    translate: 0 -500px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-in;
}

.slide-visible {
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* Map Selection */
.map-item {
    flex-direction: row;
    height: 100px;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: #333;
    border-radius: 4px;
    overflow: hidden;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale;
}

.map-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: #555;
}

.map-item.selected {
    background-color: rgba(212, 175, 55, 0.15);
    border-color: var(--color-primary);
    border-width: 2px;
}
