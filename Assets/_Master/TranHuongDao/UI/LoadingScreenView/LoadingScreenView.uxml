<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <ui:VisualElement class="view-root flex-col" style="background-color: #121212;">
        
        <!-- Top Navigation Bar -->
        <ui:VisualElement class="top-bar" style="background-color: #222; border-bottom-width: 4px; border-bottom-color: #c0914a; height: 50px;">
            <ui:Label text="WARCRAFT III REFORGED" style="color: #c0914a; font-size: 16px; -unity-font-style: bold-and-italic; letter-spacing: 2px;" />
            <ui:VisualElement class="flex-row">
                <ui:Label text="*" style="color: #888; margin-right: 15px;" />
                <ui:Label text="?" style="color: #888;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="flex-row flex-1" style="background-color: #7b9690;">
            <!-- Main Content Area with 4 quadrants background trick (using simple bg color for now) -->
            
            <ui:VisualElement class="flex-row flex-1" style="padding: 40px; justify-content: space-around; align-items: center;">
                
                <!-- Left: Map -->
                <ui:VisualElement style="width: 450px; height: 550px; background-color: #111; border-width: 2px; border-color: #c0914a; justify-content: center; align-items: center;">
                    <ui:VisualElement style="position: absolute; width: 10px; height: 10px; border-top-width: 2px; border-left-width: 2px; border-color: #c0914a; top: 10px; left: 10px;" />
                    <ui:VisualElement style="position: absolute; width: 10px; height: 10px; border-bottom-width: 2px; border-right-width: 2px; border-color: #c0914a; bottom: 10px; right: 10px;" />
                    
                    <ui:Label text="[ Map Graphic Placeholder ]" class="text-white" />
                    <ui:Label text="ASHENVALE FOREST" style="background-color: #222; color: #c0914a; padding: 10px; margin-top: 20px;" />
                </ui:VisualElement>

                <!-- Right: Chapter Info -->
                <ui:VisualElement style="width: 400px; height: 550px; justify-content: center; padding-left: 20px;">
                    <ui:Label text="CHAPTER TWO" style="color: #f2cb5d; font-size: 36px; -unity-font-style: italic; margin-bottom: 5px;" />
                    <ui:Label text="DAUGHTERS OF&#10;THE MOON" class="text-white" style="font-size: 28px; -unity-font-style: bold; margin-bottom: 50px;" />

                    <!-- Center Icon Box -->
                    <ui:VisualElement style="width: 200px; height: 200px; background-color: #222; border-width: 2px; border-color: #111; justify-content: center; align-items: center; align-self: center; margin-bottom: 40px;">
                        <ui:VisualElement style="position: absolute; width: 10px; height: 10px; background-color: #c0914a; top: -2px; left: -2px;" />
                        <ui:VisualElement style="position: absolute; width: 10px; height: 10px; background-color: #c0914a; bottom: -2px; right: -2px;" />
                        
                        <ui:VisualElement style="width: 80px; height: 80px; background-color: #c0914a; border-radius: 40px;" />
                    </ui:VisualElement>

                    <!-- Quote -->
                    <ui:Label text='"The night elves of Kalimdor have guarded their ancient forests for ten thousand years. Now, a dark tide rises from the eastern shores, threatening to consume the World Tree."' style="color: #ddd; -unity-font-style: italic; white-space: normal; -unity-text-align: middle-right; font-size: 14px; padding-right: 20px;" />

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Loading Bar -->
        <ui:VisualElement style="height: 100px; background-color: #1a1a1a; justify-content: center; padding-left: 100px; padding-right: 100px;">
            <ui:VisualElement class="flex-row space-between" style="margin-bottom: 10px;">
                <ui:Label text="LOADING ASSETS..." style="color: #666; font-size: 12px; letter-spacing: 2px;" />
                <ui:Label name="lbl-progress" text="78 %" style="color: #f2cb5d; font-size: 14px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement style="height: 15px; background-color: #000; border-width: 1px; border-color: #333;">
                <ui:VisualElement name="bar-progress" style="width: 78%; height: 100%; background-color: #f2cb5d;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
