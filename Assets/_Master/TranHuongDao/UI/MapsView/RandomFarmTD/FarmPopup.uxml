<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../../Common.uss" />
    <Style src="RandomFarmPopups.uss" />
    <ui:VisualElement class="popup-overlay" picking-mode="Position">
        <ui:VisualElement class="popup-window" picking-mode="Position">
            
            <ui:VisualElement class="popup-header">
                <ui:Label text="• FARM MANAGEMENT" class="text-gold" style="font-size: 24px; -unity-font-style: bold;" />
                <ui:Button name="btn-close" text="✕" class="popup-close-btn" />
            </ui:VisualElement>

            <ui:VisualElement class="bg-neutral-light" style="padding: 12px; border-width: 1px; border-color: #444; margin-bottom: 20px; flex-direction: row; align-items: center; justify-content: space-between; border-radius: 4px;">
                <ui:Label text="COLLECTED SEEDS" class="text-gray" style="font-size: 10px;" />
                <ui:Label text="50" class="text-gold" style="font-size: 20px; -unity-font-style: bold;" />
            </ui:VisualElement>

            <ui:VisualElement class="flex-row space-between" style="flex-wrap: wrap;">
                <!-- Slot 1 -->
                <ui:VisualElement style="width: 175px; height: 160px; background-color: #0d0d0d; border-width: 1px; border-color: #333; align-items: center; justify-content: center; margin-bottom: 12px; border-radius: 4px;">
                    <ui:Label text="CARROT" class="text-gold" style="font-size: 9px; margin-bottom: 8px;" />
                    <ui:VisualElement style="width: 50px; height: 50px; background-color: #222; margin-bottom: 10px; border-width: 1px; border-color: #444;" />
                    <ui:Label text="2 GROWING" class="text-green" style="font-size: 10px;" />
                </ui:VisualElement>

                 <!-- Slot 2 -->
                <ui:VisualElement style="width: 175px; height: 160px; background-color: #0d0d0d; border-width: 1px; border-color: #333; align-items: center; justify-content: center; margin-bottom: 12px; border-radius: 4px;">
                    <ui:Label text="PUMPKIN" class="text-gold" style="font-size: 9px; margin-bottom: 8px;" />
                    <ui:VisualElement style="width: 50px; height: 50px; background-color: #222; margin-bottom: 10px; border-width: 1px; border-color: #444;" />
                    <ui:Label text="1 GROWING" class="text-green" style="font-size: 10px;" />
                </ui:VisualElement>

                 <!-- Slot 3 -->
                <ui:VisualElement style="width: 175px; height: 160px; background-color: #0d0d0d; border-width: 1px; border-color: #333; align-items: center; justify-content: center; margin-bottom: 12px; border-radius: 4px;">
                    <ui:Label text="GRAPE" class="text-gold" style="font-size: 9px; margin-bottom: 8px;" />
                    <ui:VisualElement style="width: 50px; height: 50px; background-color: #222; margin-bottom: 10px; border-width: 1px; border-color: #444; opacity: 0.3;" />
                    <ui:Label text="EMPTY SLOT" class="text-gray" style="font-size: 10px;" />
                </ui:VisualElement>
            </ui:VisualElement>

             <ui:VisualElement class="bg-neutral-light" style="padding: 12px; border-width: 1px; border-color: #444; margin-top: auto; border-radius: 4px;">
                <ui:Label text="CURRENT HARVEST" class="text-gold" style="margin-bottom: 10px; font-size: 12px;" />
                <ui:VisualElement class="flex-row space-between">
                    <ui:Label text="🥕 Carrots:" class="text-white" style="font-size: 11px;" />
                    <ui:Label text="15" class="text-gold" style="font-size: 11px;" />
                </ui:VisualElement>
                 <ui:VisualElement class="flex-row space-between">
                    <ui:Label text="🎃 Pumpkins:" class="text-white" style="font-size: 11px;" />
                    <ui:Label text="8" class="text-gold" style="font-size: 11px;" />
                </ui:VisualElement>
                 <ui:VisualElement class="flex-row space-between">
                    <ui:Label text="🍇 Grapes:" class="text-white" style="font-size: 11px;" />
                    <ui:Label text="3" class="text-gold" style="font-size: 11px;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
